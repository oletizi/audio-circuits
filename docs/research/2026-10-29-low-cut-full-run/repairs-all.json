    {
      "before_op_index": 54,
      "note": "REPAIR A - six straight selector runs, one per contact, no corners"
    },
    {
      "before_op_index": 61,
      "note": "REPAIR A - one hi_boost_out trunk above the bank, one riser per capacitor"
    },
    {
      "before_op_index": 70,
      "note": "REPAIR A - one hi_boost_out label on the trunk, replacing two"
    },
    {
      "before_op_index": 71,
      "note": "REPAIR A - the six selector net names, re-placed on their own runs in a cascade so no two label boxes are adjacent"
    },
    {
      "before_op_index": 77,
      "note": "REPAIR B - J2's five stacked ground symbols collapse to one terminator on a trunk"
