# Dependencies
node_modules/

# Build output
dist/
build/

# The board schematic census (`bun tools/schgen/board-sheets.ts`): one directory
# per board under boards/, each holding whatever schgen produced for it, a
# STATUS.md naming its ratification class, and - for a board that produced no
# drawing - a one-page REFUSAL.kicad_sch naming the reason. Covered by build/
# above; named here so a reader of this file knows what is in there and why it is
# not committed. Every file in it is re-derived from committed sources by one run
# of that tool, and the whole directory is replaced on each run, so a committed
# copy could only fall out of date with the circuit it claims to draw.
build/schgen-boards/

# The deliberately defective fixture (`bun tools/schgen/defective-fixture.ts`):
# one real board's real geometry emitted twice, once as its own gates classified
# it and once under a fabricated defective finding, so the watermark and the
# title-block warning an unratified drawing carries are emitted by something. No
# board under boards/ is defective, so without it the marks would be code no page
# has ever shown. Covered by build/ above; named here for the same reason as the
# census directory, and re-derived whole by one run of that tool.
build/schgen-defective-fixture/

# Environment variables
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Written into the repository root by browser tooling (Playwright MCP).
.playwright-mcp/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent task briefs, reports and reviews. Working notes, not repository content;
# ignored so a `git add -A` cannot sweep them into a branch.
.superpowers/

# tools/perfboard/verbs.ts's same-directory `-o` scratch files for `--update`
# and `--set-strips`. Normally removed on both success (renamed away) and
# failure (best-effort cleanup), but this is defence in depth against one
# left behind by a crash `git add -A` would otherwise sweep into a commit.
.*.update-*.vrt
.*.strips-*.vrt
.*.import-*.vrt

# The build packet (`make guide`, tools/guide/packet.ts): every file in it is
# derived from the committed .vrt, schematic and circuit and regenerates in
# seconds, so committing it would only add a copy that can fall out of date.
# The staging directory it is assembled in is removed on success and failure;
# this is defence in depth against one left behind by a crash.
boards/*/guide/
boards/*/.guide-staging-*/

# KiCad per-user and transient files. The .kicad_pro (project) and .kicad_sch
# (schematic) are committed; these are not: .kicad_prl is each user's view
# state, the rest are lock files, automatic backups, autosaves and caches.
*.kicad_prl
~*.lck
*-backups/
_autosave-*
*.bak
fp-info-cache

# The forked VeroRoute binary, cloned and built from veroroute.pin's pinned
# commit (tools/perfboard/acquire.ts). It is a GPLv3 Qt5 C++ application with
# its own build - not vendored, not a submodule - so it is acquired locally
# rather than committed here.
.tools/
