# Dependencies
node_modules/

# Build output
dist/
build/*

# The one committed build artifact: the engine invocations the preflight proved
# (tools/krt/preflight.ts). Everything else under build/krt/ is the preflight's
# throwaway fixture and stays ignored.
!build/krt/
build/krt/*
!build/krt/invocations.json

# Two build/ subdirectories were named here with their own explanations - the
# board schematic census and the deliberately defective fixture, both written by
# tools under tools/schgen/. The schematic generator is deleted (Task 9 of
# docs/superpowers/plans/2026-10-30-remove-schgen.md) and nothing writes either
# directory any more, so the entries are gone with the tools; build/ above still
# covers anything left on a working tree from before.

# Environment variables
.env
.env.local
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Written into the repository root by browser tooling (Playwright MCP).
.playwright-mcp/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent task briefs, reports and reviews. Working notes, not repository content;
# ignored so a `git add -A` cannot sweep them into a branch.
.superpowers/

# tools/perfboard/verbs.ts's same-directory `-o` scratch files for `--update`
# and `--set-strips`. Normally removed on both success (renamed away) and
# failure (best-effort cleanup), but this is defence in depth against one
# left behind by a crash `git add -A` would otherwise sweep into a commit.
.*.update-*.vrt
.*.strips-*.vrt
.*.import-*.vrt

# The build packet (`make guide`, tools/guide/packet.ts): every file in it is
# derived from the committed .vrt, schematic and circuit and regenerates in
# seconds, so committing it would only add a copy that can fall out of date.
# The staging directory it is assembled in is removed on success and failure;
# this is defence in depth against one left behind by a crash.
boards/*/guide/
boards/*/.guide-staging-*/

# KiCad per-user and transient files. The .kicad_pro (project) and .kicad_sch
# (schematic) are committed; these are not: .kicad_prl is each user's view
# state, the rest are lock files, automatic backups, autosaves and caches.
*.kicad_prl
~*.lck
*-backups/
_autosave-*
*.bak
fp-info-cache

# Python bytecode. The measurement scripts under draughting/measure/ (and the
# remaining per-run copies under docs/research/) import a shared reader,
# kicad_sheet.py, so running one writes a __pycache__ beside it. One such
# .pyc was committed on 2026-10-30 before this line existed.
__pycache__/
*.pyc

# The forked VeroRoute binary, cloned and built from veroroute.pin's pinned
# commit (tools/perfboard/acquire.ts). It is a GPLv3 Qt5 C++ application with
# its own build - not vendored, not a submodule - so it is acquired locally
# rather than committed here.
.tools/

# The pinned schematic-drawing toolchain draughting/install.sh fetches
# (Task 3 of docs/superpowers/plans/2026-10-30-institutionalise-draughting.md):
# a copperhead git checkout and an akcli-kicad venv. draughting/tools.lock.json
# pins the versions and install.sh fetches them on demand - deliberately not
# vendored - so these two directories are a local build product of that
# script, not repository content. No trailing slash on either pattern,
# deliberately: a trailing-slash ("directory only") pattern only matches
# once the directory exists on disk, so `git check-ignore` reports NOT
# ignored before install.sh has ever run - exactly the window this entry
# exists to close.
draughting/copperhead
draughting/venv-akcli

# The host-side test venv for the SchGen drawing trial, created with
# `python3 -m venv` from tools/schgen-drawing-trial/host-requirements.txt.
tools/schgen-drawing-trial/.venv
