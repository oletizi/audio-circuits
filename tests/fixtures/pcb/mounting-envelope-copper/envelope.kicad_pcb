	(footprint "pt2399-core:MountingHole_3.2mm_M3_Washer7.0mm"
		(uuid "e5e70000-0000-4000-8000-000000000002")
		(at 35 35)
	(layer "F.Cu")
	(descr "M3 mounting hole, 3.2mm non-plated drill, WITH ITS COURTYARD SET TO THE WASHER instead of the screw head: 7.0mm, the maximum outside diameter of an M3 DIN 125 Type A / ISO 7089 flat washer (parts/washer-m3-flat-din125a-7mm-steel-zinc.json). Derived from MountingHole:MountingHole_3.2mm_M3 by changing ONE number - the F.CrtYd circle's radius, 3.45 to 3.5 - because that stock courtyard is 6.9mm and models the SCREW HEAD, which is 5.40mm across on the fastener this board fits. courtyards_overlap is the only DRC check that catches a part whose body overlaps the washer while its origin and pads sit clear, and it compares courtyards, so the courtyard IS the envelope. The drill, the np_thru_hole pad and the attributes come across untouched. tests/pcb/mounting-hardware.test.ts re-derives all of this from the installed library and the parts catalogue on every run.")
	(tags "mountinghole M3 washer envelope DIN125")
	(property "Reference" "REF**"
			(at 0 -4.15 0)
			(layer "F.SilkS")
			(effects
				(font
					(size 1 1)
					(thickness 0.15)
				)
			)
		)
