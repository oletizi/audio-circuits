(footprint "fixture_no_body_outline_P5.00mm"
	(version 20260206)
	(generator "hand-written test fixture - tests/fixtures/kicad")
	(layer "F.Cu")
	(descr "A TEST FIXTURE, not an installed KiCad footprint. It carries a courtyard and two pads at the same centres as Capacitor_THT C_Rect_L7.2mm_W2.5mm_P5.00mm and NO F.Fab graphic at all, so that lib/kicad/footprint-extent.ts has something to refuse. All 15,447 footprints in the installed KiCad libraries carry F.Fab - measured on 2026-10-14 - so the refusal is unreachable from a real name and this file is the only way to exercise it. The courtyard is present on purpose: it is what the body outline was once going to be derived from, and it is not the answer.")
	(tags "fixture")
	(attr through_hole)
	(fp_rect
		(start -1.35 -1.5)
		(end 6.35 1.5)
		(stroke
			(width 0.05)
			(type solid)
		)
		(fill no)
		(layer "F.CrtYd")
	)
	(pad "1" thru_hole circle
		(at 0 0)
		(size 1.5 1.5)
		(drill 0.75)
		(layers "*.Cu" "*.Mask")
	)
	(pad "2" thru_hole circle
		(at 5 0)
		(size 1.5 1.5)
		(drill 0.75)
		(layers "*.Cu" "*.Mask")
	)
)
