(footprint "fixture_poly_body_outline_P5.00mm"
	(version 20260206)
	(generator "hand-written test fixture - tests/fixtures/kicad")
	(layer "F.Cu")
	(descr "A TEST FIXTURE, not an installed KiCad footprint. Its body outline on F.Fab is an fp_poly - a form KiCad really does write, and one that no footprint this repository places carries on F.Fab, so lib/kicad/footprint-extent.ts deliberately does not handle it. The fixture exists so the whitelist's refusal is exercised by a real form rather than an invented one: a form skipped silently would make a body outline smaller than the part.")
	(tags "fixture")
	(attr through_hole)
	(fp_poly
		(pts
			(xy -1.1 -1.25)
			(xy 6.1 -1.25)
			(xy 6.1 1.25)
			(xy -1.1 1.25)
		)
		(stroke
			(width 0.1)
			(type solid)
		)
		(fill no)
		(layer "F.Fab")
	)
	(pad "1" thru_hole circle
		(at 0 0)
		(size 1.5 1.5)
		(drill 0.75)
		(layers "*.Cu" "*.Mask")
	)
	(pad "2" thru_hole circle
		(at 5 0)
		(size 1.5 1.5)
		(drill 0.75)
		(layers "*.Cu" "*.Mask")
	)
)
