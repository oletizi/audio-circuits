{
  "name": "audio-circuits",
  "version": "1.0.0",
  "description": "Audio circuits as a declarative model, verified in SPICE",
  "keywords": [
    "circuit",
    "spice",
    "electronics"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "perfboard": "bun run tools/cli/perfboard.ts",
    "schematic-stub": "bun run tools/cli/schematic-stub.ts",
    "schgen": "bun run tools/cli/schgen.ts",
    "schgen-parity": "bun run tools/cli/schgen-parity.ts",
    "schgen-anchors": "bun run tools/cli/schgen-anchors.ts",
    "parts": "bun run tools/cli/parts.ts"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "eecircuit-engine": "1.5.8",
    "elkjs": "0.9.3"
  }
}
