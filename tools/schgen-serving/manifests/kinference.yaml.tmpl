# Kinference in front of the merged model, after
# kinference.ai/docs/guides/basic-inference-serving/ (read 2026-11-09).
# KV_BLOCK_SIZE is filled by apply-kinference.sh from a measured value; there
# is no default, because Kinference's reference warns it need not equal vLLM's
# --block-size.
---
apiVersion: kinference.buoyant.io/v1alpha1
kind: InferenceWorkerSet
metadata:
  name: schgen-merged
  namespace: default
spec:
  profile: default
  kvBlockSize: ${KV_BLOCK_SIZE}
  serviceRef:
    name: schgen-merged
    port: http
  kvEvents:
    port: kv-pub
---
apiVersion: kinference.buoyant.io/v1alpha1
kind: InferencePool
metadata:
  name: inference-pool
  namespace: default
spec:
  destinations:
    - {kind: InferenceWorkerSet, name: schgen-merged}
---
apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: kinference-gw
  namespace: default
spec:
  gatewayClassName: buoyant-gateway
  listeners:
    - {name: http, protocol: HTTP, port: 8080}
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: kinference-route
  namespace: default
spec:
  parentRefs:
    - {name: kinference-gw, sectionName: http}
  rules:
    - matches:
        - path: {type: PathPrefix, value: /v1/chat/completions}
      backendRefs:
        - {kind: InferencePool, group: kinference.buoyant.io, name: inference-pool}
    # The SchGen trial sends token-ID prompts to /v1/completions, same backend.
    - matches:
        - path: {type: PathPrefix, value: /v1/completions}
      backendRefs:
        - {kind: InferencePool, group: kinference.buoyant.io, name: inference-pool}
